# Student Marketplace Environment Configuration
# Copy this file to .env and fill in your values

# Gemini API Key for AI-powered recommendations
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Django Configuration (optional)
# DJANGO_SECRET_KEY=your-secret-key-here
# DEBUG=True

# Email delivery (used by account verification and email 2FA)
# Local testing: console backend
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Render / production: Gmail API backend (recommended when SMTP is blocked)
# EMAIL_BACKEND=marketplace.email_backends.GmailAPIBackend
# GMAIL_CLIENT_ID=your-google-oauth-client-id
# GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
# GMAIL_REFRESH_TOKEN=your-google-oauth-refresh-token
# GMAIL_SENDER_EMAIL=your-gmail-address@gmail.com
# DEFAULT_FROM_EMAIL=UBXchange Security <your-gmail-address@gmail.com>

# SMTP is still supported, but may not work on Render free tier
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False

# Email 2FA settings
# 100 seconds default OTP lifetime
# EMAIL_2FA_CODE_TTL_SECONDS=100
# EMAIL_2FA_MAX_ATTEMPTS=5
# EMAIL_2FA_RESEND_COOLDOWN_SECONDS=60
# Require step-up OTP again for sensitive actions after this many seconds
# EMAIL_2FA_SENSITIVE_WINDOW_SECONDS=600
