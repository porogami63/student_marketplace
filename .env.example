# Student Marketplace Environment Configuration
# Copy this file to .env and fill in your values

# Gemini API Key for AI-powered recommendations
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Django Configuration (optional)
# DJANGO_SECRET_KEY=your-secret-key-here
# DEBUG=True

# Email delivery (used by account verification and email 2FA)
# For local testing with no real email delivery, keep console backend.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For real SMTP delivery (example: Gmail SMTP)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=UBXchange Security <your-email@gmail.com>
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False

# Email 2FA settings
# 100 seconds default OTP lifetime
# EMAIL_2FA_CODE_TTL_SECONDS=100
# EMAIL_2FA_MAX_ATTEMPTS=5
# EMAIL_2FA_RESEND_COOLDOWN_SECONDS=60
# Require step-up OTP again for sensitive actions after this many seconds
# EMAIL_2FA_SENSITIVE_WINDOW_SECONDS=600
